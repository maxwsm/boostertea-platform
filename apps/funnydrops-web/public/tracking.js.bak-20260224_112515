// BoosterTea Conversion Tracking Integration
// TODO: Replace placeholder IDs with real ones
(function(){
  var GA_ID = window.__BT_GA_ID || 'G-45YDTHJ607';
  var FB_PIXEL = window.__BT_FB_PIXEL || '947965164412997';
  var TT_PIXEL = window.__BT_TT_PIXEL || 'D6EMPDBC77U3L7SPCGU0';

  // === Conversion Events Bridge ===
  window.BT_Track = {
    // Called on add to cart
    addToCart: function(product, price) {
      // Google
      if(typeof gtag === 'function') gtag('event', 'add_to_cart', {currency:'UAH', value:price, items:[{item_name:product}]});
      // Facebook
      if(typeof fbq === 'function') fbq('track', 'AddToCart', {content_name:product, value:price, currency:'UAH'});
      // TikTok
      if(typeof ttq !== 'undefined') ttq.track('AddToCart', {content_name:product, value:price, currency:'UAH'});
      // Internal funnel
      if(window.BoosterFunnel) window.BoosterFunnel.trackAddToCart(product);
    },

    // Called on checkout start
    checkoutStart: function(total) {
      if(typeof gtag === 'function') gtag('event', 'begin_checkout', {currency:'UAH', value:total});
      if(typeof fbq === 'function') fbq('track', 'InitiateCheckout', {value:total, currency:'UAH'});
      if(typeof ttq !== 'undefined') ttq.track('InitiateCheckout', {value:total, currency:'UAH'});
      if(window.BoosterFunnel) window.BoosterFunnel.trackCheckoutStart();
    },

    // Called on successful order
    purchase: function(orderId, total, items) {
      if(typeof gtag === 'function') gtag('event', 'purchase', {transaction_id:orderId, value:total, currency:'UAH', items:items||[]});
      if(typeof fbq === 'function') fbq('track', 'Purchase', {value:total, currency:'UAH', content_ids:[orderId]});
      if(typeof ttq !== 'undefined') ttq.track('CompletePayment', {value:total, currency:'UAH', content_id:orderId});
      if(window.BoosterFunnel) window.BoosterFunnel.trackOrderCreated(orderId);
    },

    // Called on product view
    viewProduct: function(product, price, slug) {
      if(typeof gtag === 'function') gtag('event', 'view_item', {currency:'UAH', value:price, items:[{item_name:product}]});
      if(typeof fbq === 'function') fbq('track', 'ViewContent', {content_name:product, value:price, currency:'UAH'});
      if(typeof ttq !== 'undefined') ttq.track('ViewContent', {content_name:product, value:price, currency:'UAH'});
      if(window.BoosterFunnel) window.BoosterFunnel.trackProductView(slug || product);
    },

    // Called on lead/contact form
    lead: function(source) {
      if(typeof gtag === 'function') gtag('event', 'generate_lead', {event_category:source||'site'});
      if(typeof fbq === 'function') fbq('track', 'Lead', {content_category:source||'site'});
      if(typeof ttq !== 'undefined') ttq.track('SubmitForm');
    },

    // Called on registration
    register: function() {
      if(typeof gtag === 'function') gtag('event', 'sign_up');
      if(typeof fbq === 'function') fbq('track', 'CompleteRegistration');
      if(typeof ttq !== 'undefined') ttq.track('CompleteRegistration');
    }
  };

  console.log('[BT] Conversion tracking ready (GA:'+GA_ID+' FB:'+FB_PIXEL+' TT:'+TT_PIXEL+')');
})();
