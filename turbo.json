{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "JWT_SECRET", "PACKIFY_API_KEY", "VITE_API_URL", "NEXT_PUBLIC_SITE_URL", "NEXT_PUBLIC_APP_URL", "REDIS_URL"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
